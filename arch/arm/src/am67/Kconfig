#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

comment "AM67 Configuration Options"

config AM67_GPIO
	bool "AM67 padconfig GPIO driver"
	default y
	---help---
		Enable the AM67 GPIO driver that drives pads configured as
		GPIO through the padconfig registers (LED, IMU_EN and the
		SPI chip selects).

config AM67_MCSPI0
	bool "AM67 MCU_MCSPI0 master driver"
	default n
	depends on SPI
	---help---
		Enable the polled SPI master driver for MCU_MCSPI0 at
		0x04b00000, used by the onboard ICM-20948 IMU (CS3) and
		LPS22DF barometer (CS1).

if AM67_MCSPI0

config AM67_MCSPI0_FCLK
	int "MCU_MCSPI0 functional clock (Hz)"
	default 48000000

endif
