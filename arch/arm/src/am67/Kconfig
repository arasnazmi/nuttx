#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

comment "AM67 Configuration Options"

config ARCH_LOWPUTC
	bool
	default y
	---help---
		The AM67 serial console (16550) provides up_putc(), polled
		low-level character output that works even from panic/assert
		context with interrupts disabled.  Declaring ARCH_LOWPUTC lets
		SYSLOG_DEFAULT and the assert dump use it.
