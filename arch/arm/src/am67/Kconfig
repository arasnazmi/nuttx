#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

comment "AM67 Configuration Options"

config AM67_GPIO
	bool "AM67 padconfig GPIO driver"
	default y
	---help---
		Enable the AM67 GPIO driver that drives pads configured as
		GPIO through the padconfig registers (LED, IMU_EN and the
		SPI chip selects).

config AM67_EPWM0
	bool "AM67 EPWM0 driver"
	default n
	depends on PWM
	select ARCH_HAVE_PWM_MULTICHAN
	---help---
		Enable EPWM driver on EPWM0 (outputs A and B; requires
		PWM_MULTICHAN with PWM_NCHANNELS >= 2)

config AM67_EPWM1
	bool "AM67 EPWM1 driver"
	default n
	depends on PWM
	select ARCH_HAVE_PWM_MULTICHAN
	---help---
		Enable EPWM driver on EPWM1 (outputs A and B on HAT GPIO-6
		and GPIO-13; requires PWM_MULTICHAN with PWM_NCHANNELS >= 2).
		EPWM2 is the board cooling fan and is deliberately not
		supported.


config AM67_MCSPI0
	bool "AM67 MCU_MCSPI0 master driver"
	default n
	depends on SPI
	---help---
		Enable the polled SPI master driver for MCU_MCSPI0 at
		0x04b00000, used by the onboard ICM-20948 IMU (CS3) and
		LPS22DF barometer (CS1).

if AM67_MCSPI0

config AM67_MCSPI0_FCLK
	int "MCU_MCSPI0 functional clock (Hz)"
	default 48000000

endif
